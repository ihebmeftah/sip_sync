{
  "version": "0.2.0",
  "configurations": [
    // If the server pubspec configures multiple Flutter apps, add an attach
    // configuration like this for each app and add every configuration name
    // to the compound below. Use the VM-service info file pattern
    // `${workspaceFolder}/sip_sync_server/.dart_tool/serverpod/flutter-vm-service-info-<appId>.json`,
    // where `<appId>` is the app's key under `serverpod.flutter_apps` in the
    // server pubspec.
    {
      // Attaches to the Flutter app `serverpod start` spawns. Don't
      // launch a second instance here - it would race for the port.
      "name": "sip_sync_flutter",
      "type": "dart",
      "request": "attach",
      "vmServiceInfoFile": "${workspaceFolder}/sip_sync_server/.dart_tool/serverpod/flutter-vm-service-info-sip_sync.json",
      "preLaunchTask": "serverpod_start",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "sip_sync_server",
      "type": "dart",
      "request": "attach",
      "vmServiceInfoFile": "${workspaceFolder}/sip_sync_server/.dart_tool/serverpod/vm-service-info.json",
      "preLaunchTask": "serverpod_start",
      "internalConsoleOptions": "neverOpen"
    },
    {
      // Physical phone/tablet: localhost in config.json won't reach the Mac.
      // Keep serverpod start (API :8080) running. Update the IP if your LAN changes
      // (`ipconfig getifaddr en0`). Select your device in the status bar first.
      "name": "managment (device)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/managment",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=SERVER_URL=http://192.168.0.67:8080"
      ]
    }
  ],
  "compounds": [
    {
      "name": "sip_sync (full stack)",
      "configurations": [
        "sip_sync_server",
        "sip_sync_flutter"
      ],
      // Stopping one session stops both; the orphan blocks re-attach.
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    }
  ]
}
